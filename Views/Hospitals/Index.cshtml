@model IEnumerable<MEDICINE.WEB.Models.Hospital>

@{
    ViewData["Title"] = "Hospitals";
}

<section class="py-5 bg-light">
    <div class="container text-center">
        <h1 class="fw-bold">Hospitals</h1>
        <p class="text-muted">Find trusted hospitals for your medical treatment</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">

            @foreach (var hospital in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0">

                        @if (!string.IsNullOrEmpty(hospital.ImagePath))
                        {
                            <img src="@hospital.ImagePath" class="card-img-top" style="height:220px;object-fit:cover;" />
                        }
                        else if (!string.IsNullOrEmpty(hospital.LogoPath))
                        {
                            <img src="@hospital.LogoPath" class="card-img-top p-4" style="height:220px;object-fit:contain;" />
                        }

                        <div class="card-body">

                            @if (hospital.IsFeatured)
                            {
                                <span class="badge bg-success mb-2">Featured</span>
                            }

                            <h5 class="fw-bold">@hospital.NameEn</h5>

                            <p class="text-muted mb-2">
                                @hospital.CityMaster?.NameEn
                                @if (hospital.CityMaster != null && hospital.CountryMaster != null)
                                {
                                    <span>, </span>
                                }
                                @hospital.CountryMaster?.NameEn
                            </p>

                            @if (!string.IsNullOrEmpty(hospital.ShortDescriptionEn))
                            {
                                <p class="text-muted">@hospital.ShortDescriptionEn</p>
                            }

                            @if (!string.IsNullOrEmpty(hospital.Slug))
                            {
                                <a href="/hospitals/@hospital.Slug" class="btn btn-primary">
                                    View Details
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Hospitals"
                                   asp-action="Details"
                                   asp-route-id="@hospital.Id"
                                   class="btn btn-primary">
                                    View Details
                                </a>
                            }

                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</section>