<!-- FAQ Section -->
@if (Model.Faqs != null && Model.Faqs.Any())
{
    <section class="py-5">
        <div class="container">

            <div class="mb-4">
                <h2>Frequently Asked Questions (FAQ’s)</h2>
            </div>

            <div class="accordion" id="homeFaqAccordion">

                @{
                    int faqIndex = 1;
                }

                @foreach (var faq in Model.Faqs)
                {
                    var faqId = "faq" + faqIndex;

                    <div class="accordion-item mb-3 border-primary">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@faqId">
                                @faq.QuestionEn
                            </button>
                        </h2>

                        <div id="@faqId"
                             class="accordion-collapse collapse"
                             data-bs-parent="#homeFaqAccordion">
                            <div class="accordion-body">
                                @Html.Raw(faq.AnswerEn)
                            </div>
                        </div>
                    </div>

                    faqIndex++;
                }

            </div>

        </div>
    </section>
}

