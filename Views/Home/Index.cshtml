@model MEDICINE.WEB.ViewModels.Home.HomePageViewModel

@{
    ViewData["Title"] = "Home";
}

<!-- Dynamic Banner Section -->
@if (Model.Banners != null && Model.Banners.Any())
{
    var banner = Model.Banners.First();

    <section class="bg-primary text-white py-5">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-md-6">
                    <h1 class="display-4 fw-bold">@banner.TitleEn</h1>

                    @if (!string.IsNullOrEmpty(banner.SubTitleEn))
                    {
                        <p class="lead mt-3">@banner.SubTitleEn</p>
                    }

                    <div class="mt-4">
                        @if (!string.IsNullOrEmpty(banner.ButtonTextEn) && !string.IsNullOrEmpty(banner.ButtonUrl))
                        {
                            <a href="@banner.ButtonUrl" class="btn btn-light btn-lg me-2">
                                @banner.ButtonTextEn
                            </a>
                        }

                        <a href="https://wa.me/979690012794" target="_blank" class="btn btn-success btn-lg">
                            WhatsApp Us
                        </a>
                    </div>
                </div>

                <div class="col-md-6 text-center">
                    <img src="@banner.ImagePath"
                         alt="@banner.TitleEn"
                         class="img-fluid rounded shadow">
                </div>

            </div>
        </div>
    </section>
}
else
{
    <section class="bg-primary text-white py-5">
        <div class="container">
            <h1>World-Class Medical Treatment in India</h1>
            <p class="lead">Complete medical travel care for international patients.</p>
            <a href="/PublicInquiry/Contact" class="btn btn-light btn-lg">Book Free Consultation</a>
        </div>
    </section>
}

<!-- Featured Treatments -->
<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2>Popular Treatments</h2>
            <p>Explore top medical treatments available in India</p>
        </div>

        <div class="row g-4">
            @foreach (var treatment in Model.FeaturedTreatments)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrEmpty(treatment.ImagePath))
                        {
                            <img src="@treatment.ImagePath"
                                 class="card-img-top"
                                 style="height:200px;object-fit:cover;"
                                 alt="@treatment.NameEn">
                        }

                        <div class="card-body">
                            <h5>@treatment.NameEn</h5>

                            @if (!string.IsNullOrEmpty(treatment.ShortDescriptionEn))
                            {
                                <p>@treatment.ShortDescriptionEn</p>
                            }

                            <a href="/Treatments/Details/@treatment.Id" class="btn btn-outline-primary">
                                View Details
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>

    </div>
</section>

<!-- Featured Hospitals -->
<section class="py-5 bg-light">
    <div class="container">

        <div class="text-center mb-5">
            <h2>Featured Hospitals</h2>
            <p>Trusted hospitals for international patients</p>
        </div>

        <div class="row g-4">
            @foreach (var hospital in Model.FeaturedHospitals)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrEmpty(hospital.ImagePath))
                        {
                            <img src="@hospital.ImagePath"
                                 class="card-img-top"
                                 style="height:200px;object-fit:cover;"
                                 alt="@hospital.NameEn">
                        }

                        <div class="card-body">
                            <h5>@hospital.NameEn</h5>

                            @if (!string.IsNullOrEmpty(hospital.ShortDescriptionEn))
                            {
                                <p>@hospital.ShortDescriptionEn</p>
                            }

                            <a href="/Hospitals/Details/@hospital.Id" class="btn btn-outline-primary">
                                View Details
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>

    </div>
</section>

<!-- Featured Doctors -->
<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2>Featured Doctors</h2>
            <p>Consult with experienced medical specialists</p>
        </div>

        <div class="row g-4">
            @foreach (var doctor in Model.FeaturedDoctors)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm text-center">

                        @if (!string.IsNullOrEmpty(doctor.ImagePath))
                        {
                            <img src="@doctor.ImagePath"
                                 class="card-img-top"
                                 style="height:240px;object-fit:cover;"
                                 alt="@doctor.FullNameEn">
                        }

                        <div class="card-body">
                            <h5>@doctor.FullNameEn</h5>

                            @if (!string.IsNullOrEmpty(doctor.DesignationEn))
                            {
                                <p class="text-muted">@doctor.DesignationEn</p>
                            }

                            <p>@doctor.ExperienceYears Years Experience</p>

                            <a href="/Doctors/Details/@doctor.Id" class="btn btn-outline-primary">
                                View Profile
                            </a>
                        </div>

                    </div>
                </div>
            }            
        </div>

    </div>
</section>
@if (Model.FeaturedTestimonials != null &&
     Model.FeaturedTestimonials.Any())
{
    <section class="py-5 bg-light">

        <div class="container">

            <div class="text-center mb-5">

                <h2 class="fw-bold">
                    Patient Success Stories
                </h2>

                <p class="text-muted">
                    Trusted by patients from around the world.
                </p>

            </div>

            <div class="row">

                @foreach (var item in Model.FeaturedTestimonials)
                {
                    <div class="col-lg-4 mb-4">

                        <div class="card h-100 shadow-sm border-0">

                            <div class="card-body text-center">

                                @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                {
                                    <img src="@item.ImagePath"
                                         style="width:90px;height:90px;border-radius:50%;object-fit:cover;"
                                         class="mb-3" />
                                }

                                <h5>
                                    @item.PatientNameEn
                                </h5>

                                <p class="text-muted">
                                    @item.CountryEn
                                </p>

                                @if (!string.IsNullOrWhiteSpace(item.TreatmentNameEn))
                                {
                                    <span class="badge bg-primary mb-3">
                                        @item.TreatmentNameEn
                                    </span>
                                }

                                <div class="mb-3">
                                    @for (int i = 1; i <= item.Rating; i++)
                                    {
                                        <span>⭐</span>
                                    }
                            </div>

                            <p>
                                @(!string.IsNullOrWhiteSpace(item.StoryEn) &&
                                                            item.StoryEn.Length > 120
                                                            ? item.StoryEn.Substring(0, 120) + "..."
                                                            : item.StoryEn)
                        </p>

                            </div>

                        </div>

                    </div>
                        }

            </div>

            <div class="text-center mt-4">

                <a href="/testimonials"
                   class="btn btn-primary">
                    View All Success Stories
                </a>

            </div>

        </div>

    </section>
}

