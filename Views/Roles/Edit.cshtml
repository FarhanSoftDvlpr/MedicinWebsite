@model MEDICINE.WEB.Areas.Admin.ViewModels.RoleEditViewModel

@{
    ViewData["Title"] = "Edit Role";
}

<div class="container-fluid">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4>Edit Role</h4>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Role Key</label>
                        <input asp-for="RoleKey"
                               class="form-control"
                               readonly />
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"></textarea>
                </div>

                <hr />

                <h5 class="mb-3">
                    Permission Assignment Matrix
                </h5>

                @{
                    var groupedPermissions = Model.Permissions
                        .GroupBy(x => x.Category)
                        .OrderBy(x => x.Key);
                }

                @foreach (var category in groupedPermissions)
                {
                    <div class="card mb-3">

                        <div class="card-header bg-light">
                            <strong>@category.Key</strong>
                        </div>

                        <div class="card-body">

                            <div class="row">

                                @foreach (var permission in category)
                                {
                                    <div class="col-md-4 mb-2">

                                        <div class="form-check">

                                            <input type="hidden"
                                                   name="Permissions[@Model.Permissions.IndexOf(permission)].PermissionId"
                                                   value="@permission.PermissionId" />

                                            <input type="hidden"
                                                   name="Permissions[@Model.Permissions.IndexOf(permission)].PermissionName"
                                                   value="@permission.PermissionName" />

                                            <input type="hidden"
                                                   name="Permissions[@Model.Permissions.IndexOf(permission)].PermissionKey"
                                                   value="@permission.PermissionKey" />

                                            <input type="hidden"
                                                   name="Permissions[@Model.Permissions.IndexOf(permission)].Category"
                                                   value="@permission.Category" />

                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="Permissions[@Model.Permissions.IndexOf(permission)].IsSelected"
                                                   value="true"
                                                   @(permission.IsSelected ? "checked" : "") />

                                            <label class="form-check-label">
                                                @permission.PermissionName
                                            </label>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                }

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Update Role
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}