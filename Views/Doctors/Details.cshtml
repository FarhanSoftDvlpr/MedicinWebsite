@model MEDICINE.WEB.ViewModels.Doctors.DoctorDetailsViewModel

@{
    ViewData["Title"] = Model.Doctor.FullNameEn;
}

<section class="py-5 bg-primary text-white">
    <div class="container">
        <h1 class="fw-bold">@Model.Doctor.FullNameEn</h1>

        @if (!string.IsNullOrEmpty(Model.Doctor.DesignationEn))
        {
            <p class="lead mb-0">@Model.Doctor.DesignationEn</p>
        }
    </div>
</section>

<section class="py-5">
    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="row g-4">

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <div class="row g-4 align-items-start">

                            <div class="col-md-4">
                                @if (!string.IsNullOrEmpty(Model.Doctor.ImagePath))
                                {
                                    <img src="@Model.Doctor.ImagePath"
                                         class="img-fluid rounded shadow-sm"
                                         style="width:100%;object-fit:cover;" />
                                }
                            </div>

                            <div class="col-md-8">
                                <h3 class="fw-bold">@Model.Doctor.FullNameEn</h3>

                                @if (!string.IsNullOrEmpty(Model.Doctor.DesignationEn))
                                {
                                    <p class="text-primary mb-2">@Model.Doctor.DesignationEn</p>
                                }

                                @if (!string.IsNullOrEmpty(Model.Doctor.QualificationEn))
                                {
                                    <p><strong>Qualification:</strong> @Model.Doctor.QualificationEn</p>
                                }

                                <p><strong>Experience:</strong> @Model.Doctor.ExperienceYears Years</p>

                                @if (!string.IsNullOrEmpty(Model.Doctor.Languages))
                                {
                                    <p><strong>Languages:</strong> @Model.Doctor.Languages</p>
                                }

                                @if (!string.IsNullOrEmpty(Model.Doctor.Hospital?.NameEn))
                                {
                                    <p><strong>Hospital:</strong> @Model.Doctor.Hospital.NameEn</p>
                                }

                                <p>
                                    <strong>Location:</strong>
                                    @Model.Doctor.City?.NameEn
                                    @if (Model.Doctor.City != null && Model.Doctor.Country != null)
                                    {
                                        <span>, </span>
                                    }
                                    @Model.Doctor.Country?.NameEn
                                </p>
                            </div>

                        </div>
                    </div>
                </div>

                @if (Model.Treatments != null && Model.Treatments.Any())
                {
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">
                            <h3 class="fw-bold mb-3">Specialized Treatments</h3>

                            @foreach (var treatment in Model.Treatments)
                            {
                                <a asp-controller="Treatments"
                                   asp-action="Details"
                                   asp-route-id="@treatment.Id"
                                   class="badge bg-light text-dark border me-2 mb-2 p-2 text-decoration-none">
                                    @treatment.NameEn
                                </a>
                            }
                        </div>
                    </div>
                }

                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h3 class="fw-bold mb-3">About Doctor</h3>

                        @if (!string.IsNullOrEmpty(Model.Doctor.DescriptionEn))
                        {
                            @Html.Raw(Model.Doctor.DescriptionEn)
                        }
                        else
                        {
                            <p>@Model.Doctor.ShortDescriptionEn</p>
                        }
                    </div>
                </div>

            </div>

            <div class="col-lg-4">

                <div class="card shadow-sm border-0 sticky-top" style="top:90px;">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Book Appointment</h5>
                    </div>

                    <div class="card-body">

                        <form asp-controller="PublicInquiry"
                              asp-action="QuickSubmit"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="DoctorId" value="@Model.Doctor.Id" />
                            <input type="hidden" name="SourcePage" value="Doctor Details - @Model.Doctor.FullNameEn" />

                            <div class="mb-3">
                                <label class="form-label">Patient Name</label>
                                <input type="text"
                                       name="PatientName"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mobile Number</label>
                                <input type="text"
                                       name="MobileNumber"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email"
                                       name="Email"
                                       class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Message</label>
                                <textarea name="Message"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Tell us your preferred appointment details"></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                Submit Appointment Request
                            </button>

                        </form>

                    </div>
                </div>

            </div>

        </div>
    </div>
</section>