<form method="post" asp-controller="PublicInquiry" asp-action="QuickCallback" class="quick-quote-form">

    @Html.AntiForgeryToken()

    <div class="mb-2">
        <input type="text"
               name="patientName"
               class="form-control"
               placeholder="Patient Name"
               required />
    </div>

    <div class="mb-2">
        <input type="text"
               name="mobileNumber"
               class="form-control"
               placeholder="Your Phone Number"
               required />
    </div>

    <div class="mb-2">
        <textarea name="message"
                  class="form-control"
                  rows="3"
                  placeholder="Describe The Current Medical Problem"></textarea>
    </div>

    <button type="submit" class="btn btn-danger w-100">
        Get FREE Quote
    </button>

</form>