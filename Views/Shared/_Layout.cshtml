<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        .quick-quote-box {
            position: fixed;
            right: 25px;
            top: 160px;
            width: 360px;
            background: #ffffff;
            padding: 25px;
            border-radius: 18px;
            z-index: 9999;
        }

        @@media (max-width: 991px) {
            .quick-quote-box {
                position: static;
                width: auto;
                margin: 20px;
            }
        }
    </style>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MEDICINE WEBSITE</title>

    @if (ViewData["MetaDescription"] != null)
    {
        <meta name="description" content="@ViewData["MetaDescription"]" />
    }

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    MEDICINE
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    @await Component.InvokeAsync("PublicMenu")
                    @* <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Treatments" asp-action="Index">
                                Treatments
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Hospitals">
                                Hospitals
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Doctors">
                                Doctors
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/PublicInquiry/Contact">
                                Contact Us
                            </a>
                        </li>

                    </ul> *@
                </div>

            </div>
        </nav>
    </header>

    <main>
        @RenderBody()

        <div class="quick-quote-box shadow">
            <h4 class="text-center mb-3">Let Us Help You</h4>
            @await Html.PartialAsync("_QuickQuoteForm")
        </div>
    </main>

    @await Component.InvokeAsync("Footer")

