<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MEDICINE Admin</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="~/AdminAssets/plugins/fontawesome/css/all.min.css" rel="stylesheet" />

    <!-- Admin CSS -->
    <link href="~/AdminAssets/css/admin-style.css" rel="stylesheet" />
    <link href="~/AdminAssets/css/admin-responsive.css" rel="stylesheet" />

</head>

<body>

    <div class="admin-wrapper">

        <!-- Sidebar -->
        <partial name="_AdminSidebar" />

        <!-- Main Panel -->
        <div class="main-panel">

            <!-- Topbar -->
            <partial name="_AdminTopbar" />

            <!-- Content -->
            <div class="content-wrapper">

                @RenderBody()

            </div>

        </div>

    </div>

    <!-- jQuery -->
    <script src="~/lib/jquery/jquery.min.js"></script>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Admin JS -->
    <script src="~/AdminAssets/js/admin.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>